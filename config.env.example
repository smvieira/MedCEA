# =============================================================================
# MedCEA Configuration — copy to config.env and fill in values
# =============================================================================

# --- Project identity ---
# One name drives the MQTT topic root (<PROJECT_NAME>/<UNIT>/<ZONE>/...), the
# Kubernetes namespace and the Keycloak realm. It must be a valid namespace,
# realm and topic segment at once: lowercase, starts with a letter, [a-z0-9-].
# Changing it after boards are flashed means reflashing them (the root is
# baked into each board's device_cfg.py).
PROJECT_NAME="medcea"

# --- Cluster & Versioning ---
K8S_CHANNEL="1.29/stable"        # MicroK8s Kubernetes version
# KF_CHANNEL="1.9/stable"        # [RETIRED] Charmed Kubeflow — replaced by infra/deploy-workbench.sh
NAMESPACE="$PROJECT_NAME"

# The address every service name points to: this machine's Tailscale IP, or its
# LAN IP without Tailscale. Also the onboarding wizard address and where the
# pgAdmin pod finds Keycloak. Never derive an IP from DOMAIN — it may be a name.
# (One line on purpose: configure.sh keeps one value per key when it rebases.)
PLATFORM_IP="$(tailscale ip -4 2>/dev/null | head -1 | grep . || hostname -I | awk '{print $1}')"

# Base domain for all service ingresses: services are <name>.$DOMAIN.
#   DOMAIN="medcea"                  name-based (ai-workbench.medcea): the platform
#                                    answers DNS for it (LOCAL_DNS) and Tailscale
#                                    split DNS sends every tailnet device to it
#   DOMAIN="${PLATFORM_IP}.nip.io"   IP-based, no DNS setup at all (the default)
#   DOMAIN="lab.example.org"         your own DNS
# infra/configure.sh offers these as a menu.
DOMAIN="${PLATFORM_IP}.nip.io"

# "true": the platform runs a DNS server for $DOMAIN on PLATFORM_IP port 53
# (Deployment name-dns) and maps the names in this machine's /etc/hosts. Set by
# infra/configure.sh when you pick the name-based domain.
LOCAL_DNS="false"

# The previous IP-based domain, kept as permanent redirects to $DOMAIN so old
# links and bookmarks still work. Inactive when equal to DOMAIN or empty.
ALIAS_DOMAIN="${PLATFORM_IP}.nip.io"

# Whether DOMAIN depends on Tailscale. Set by infra/configure.sh:
#   "true"  — checked on every deploy; a deploy stops if Tailscale is not up
#   "false" — LAN only, chosen on purpose; Tailscale is not raised again
#   ""      — not decided yet; the installer explains how to set Tailscale up
USE_TAILSCALE=""

# --- Global Credentials ---
ADMIN_USER="admin"
ADMIN_EMAIL=""             # The admin's real address: Keycloak password resets, pgAdmin login
ADMIN_PASS=""              # Set a strong password

# The first person with role qa (confirms account grants, approves policy
# changes). Must be someone other than the administrator. QA_INITIAL_PASS is
# generated; Keycloak asks for a new password at first sign-in.
QA_USER=""
QA_EMAIL=""
QA_INITIAL_PASS=""

# The first person with role engineer — the only role the access policy admits
# to Node-RED, MQTT Explorer and device onboarding. May be the administrator's
# own second account, with its own username and e-mail (name+engineer@gmail.com
# works). ENGINEER_INITIAL_PASS is generated; replaced at first sign-in.
ENGINEER_USER=""
ENGINEER_EMAIL=""
ENGINEER_INITIAL_PASS=""

# Keycloak's own console account (realm master), the break-glass identity: used
# only for recovery, every use recorded in Keycloak's admin events. Never the
# platform admin's name or password. KC_BREAKGLASS_PASS is generated.
KC_BREAKGLASS_USER="kc-breakglass"
KC_BREAKGLASS_PASS=""
# Written by deploy-infra.sh: the master-realm client the deploy scripts act as.
KC_DEPLOYER_SECRET=""

# Access-policy gates (apps/iam). false renders the pre-policy role list
# (operator, qa, auditor, admin) on every compiled host — the rollback of the IAM
# plan's Phase 0; each deploy then prints a warning. Not exact for Node-RED,
# which before Phase 0 admitted any signed-in user.
IAM_GATES="true"
# false: every service runs the access check on every request (medcea_iam.check(),
# IAM plan Phase 1) but only logs "would refuse …"; true (IAM 2.6) answers 401/403/503
# to what the route table refuses (the access Admin port and dbmgmt always do).
# Live from ConfigMap medcea-iam-lib (./deploy-infra.sh, about a minute; no restart);
# each app deploy also copies it into its pod, used only when that mount is missing.
# Switch it with ./guide.sh (IAM switches → IAM_ENFORCE) after a report-only soak;
# ./health-check.sh warns (iamenforce) while it is false.
IAM_ENFORCE="false"
# Phase 2b: true makes config-api (PostgREST) verify the person's token: the Config
# UI's nginx forwards the proxy's access token as Authorization: Bearer, the edge
# wizard (edge/platform_db.py) sends its token and refuses without one, and
# authenticator logs in with AUTHENTICATOR_DB_PASS instead of POSTGRES_PASS. With
# IAM_DB_ROLES=false a verified token still runs as anon, as today, but writes are
# attributed to the person; an expired or forged token is a 401. To enable: run
# ./deploy-infra.sh (it publishes the realm's signing keys, Secret medcea-jwks key
# jwks-sig.json), set true, then ./apps/frontend/deploy.sh, which switches
# config-api and authenticator's password together. Rollback: IAM_DB_ROLES=false
# first (./apps/database/deploy.sh), then false and ./apps/frontend/deploy.sh. After
# rotating or removing a realm key run ./deploy-infra.sh (config-api restarts).
IAM_POSTGREST_JWT="false"
# Phase 2: database roles. false (default) keeps today's database access and applies
# medcea_db_migrations_down_008b.sql on every database deploy; the new roles exist but
# cannot log in. true applies per-role grants, RLS and the guard triggers; it is refused
# until IAM_POSTGREST_JWT=true, PostgREST's pre-request and JWT are wired (2b), services
# no longer use postgres (2.5) and AUTHENTICATOR_DB_PASS is set. Rollback: false, then
# ./apps/database/deploy.sh, which restarts config-api (PostgREST's pooled sessions keep
# the old mode; by hand: kubectl rollout restart deployment/config-api). Changes are
# recorded in iam_policy.history. Operators need units first: apps/iam/units.sh assign <user> <UNIT>...
IAM_DB_ROLES="false"
# Phase 2.5: each database client on its own role while IAM_DB_ROLES is still false,
# so a missing grant shows up as "permission denied" before anything is enforced.
# true: the database deploy lets the service roles log in, and every client moves to
# its role at its next deploy (scheduler svc_scheduler, monitor svc_monitor, dbmgmt
# svc_dbexport, Node-RED svc_ingest; Grafana svc_grafana and pgAdmin rr_admin_login
# with ./deploy-infra.sh). pgAdmin then holds rr_admin's grants only: no DDL, no
# writes; for those, psql in the PostgreSQL pod. IAM_DB_ROLES=true is refused until
# this is true and every client has moved. Enable: true, then ./deploy-apps.sh --all
# (the database deploy runs first) and ./deploy-infra.sh (Grafana, pgAdmin).
# Rollback: false, then the same two; a role keeps its login while a client still
# uses it, so the order does not matter (a last ./apps/database/deploy.sh drops it).
IAM_DB_SERVICE_ROLES="false"
# Database role passwords (plan 3.6), generated once by infra/configure.sh and written
# into Secrets db-<role> by apps/database/deploy.sh.
SVC_INGEST_DB_PASS=""
SVC_SCHEDULER_DB_PASS=""
SVC_MONITOR_DB_PASS=""
SVC_GRAFANA_DB_PASS=""
SVC_DBEXPORT_DB_PASS=""
IAM_SVC_DB_PASS=""
RR_ADMIN_LOGIN_DB_PASS=""
AUTHENTICATOR_DB_PASS=""
# true: one NetworkPolicy per application pod (IAM plan 1.4, network: in the access
# policy), so only its proxy and the listed hops can connect to it. false removes them
# (the rollback); so does `microk8s kubectl delete netpol -l medcea/iam-netpol=true`
# until the next deploy-infra run.
IAM_NETPOL="true"

# --- Docker Hub ---
# Required for Helm OCI chart pulls (Bitnami charts) and to avoid image pull rate limits.
# Create a PAT at: hub.docker.com → Account Settings → Security → New Access Token
DOCKERHUB_USER=""
DOCKERHUB_PAT=""

# --- Postgres ---
POSTGRES_USER="postgres"
POSTGRES_PASS=""           # Set a strong password
POSTGRES_DB="medcea_db"         # literal: the schema name "medcea" is fixed in apps/database SQL
STORAGE_SIZE="10Gi"

# --- Node-RED ---
NODE_RED_TZ="Europe/London"

# --- Keycloak ---
KEYCLOAK_DOMAIN="keycloak.$DOMAIN"
KEYCLOAK_REALM="$PROJECT_NAME"

# --- Grafana ---
# Fill GRAFANA_OAUTH_SECRET after creating the 'grafana' client in Keycloak UI
GRAFANA_DOMAIN="grafana.$DOMAIN"
GRAFANA_OAUTH_SECRET=""

# Grafana's role comes from the access policy (IAM 3.1, dashboards: U gives Editor,
# R gives Viewer, any other role cannot sign in). Grafana Admin is only the local
# break-glass account: user ADMIN_USER at https://$GRAFANA_DOMAIN/login?disableAutoLogin,
# password GRAFANA_BREAKGLASS_PASS (generated; never the admin's own password).
GRAFANA_BREAKGLASS_PASS=""
# The pre-3.1 Keycloak demo accounts and their grafana_* roles. Used only under
# IAM_GATES=false (the rollback) and kept for old installs: under true nothing
# creates them, and existing ones are left as they are.
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASS=""          # Defaults to ADMIN_PASS if left empty
GRAFANA_DEVELOPER_USER="developer"
GRAFANA_DEVELOPER_PASS=""      # Defaults to ADMIN_PASS if left empty
GRAFANA_VIEWER_USER="viewer"
GRAFANA_VIEWER_PASS=""         # Defaults to ADMIN_PASS if left empty

# --- OAuth2 Proxy (protects Node-RED) ---
# Fill OAUTH2_PROXY_SECRET after creating the 'node-red' client in Keycloak UI
# Generate OAUTH2_COOKIE_SECRET once with: openssl rand -base64 32
NODE_RED_DOMAIN="node-red.$DOMAIN"
OAUTH2_PROXY_SECRET=""
OAUTH2_COOKIE_SECRET=""

# --- pgAdmin (Database UI) ---
PGADMIN_DOMAIN="pgadmin.$DOMAIN"

# --- Database Management portal (sub-portal: pgAdmin + Export tool) ---
DBMGMT_DOMAIN="dbmgmt.$DOMAIN"

# --- Recipe Schedule Manager ---
SCHEDULER_DOMAIN="scheduler.$DOMAIN"
# --- Run Monitor Dashboard ---
MONITOR_DOMAIN="monitor.$DOMAIN"
# --- System Configuration UI ---
CONFIG_DOMAIN="config.$DOMAIN"

# --- MQTT Explorer (apps/mqtt-explorer) ---
MQTTX_DOMAIN="mqtt-explorer.$DOMAIN"

# --- Service Portal ---
PORTAL_DOMAIN="portal.$DOMAIN"
PORTAL_OAUTH2_PROXY_SECRET=""    # Auto-filled by deploy script
PORTAL_COOKIE_SECRET=""          # Auto-filled by deploy script

# --- Kubeflow / MetalLB ---
# MetalLB needs real LAN IPs (not Tailscale 100.x.x.x — MetalLB uses ARP, which doesn't
# work over WireGuard). We auto-detect the LAN IP from the default route interface and
# reserve .200-.210 on that subnet. Override if those addresses are already in use.
#
# IP STABILITY: All web UIs use Tailscale IP (stable). Only Kubeflow (MetalLB) and
# Mosquitto MQTT for IoT devices (NodePort) need the LAN IP.
# Recommendation: set a DHCP reservation in your router for this machine's MAC address.
# IoT devices can also use mDNS: $(hostname).local:31883 (if Avahi is running).
#
# To access Kubeflow from other Tailnet devices after deployment:
#   sudo tailscale up --advertise-routes="${KUBEFLOW_IP}/32"
#   Then approve the route at https://login.tailscale.com/admin/machines
_LAN_IP="$(ip route get 8.8.8.8 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')"
_LAN_SUBNET="$(echo "$_LAN_IP" | cut -d. -f1-3)"
# [RETIRED with Kubeflow] MetalLB and a static LAN IP existed only so Kubeflow's
# istio-ingressgateway could hold a real LAN address. JupyterHub is served by the
# nginx ingress like everything else, so no address needs pinning any more.
# METALLB_RANGE="${_LAN_SUBNET}.200-${_LAN_SUBNET}.210"
# KUBEFLOW_IP="${_LAN_SUBNET}.200"
# KUBEFLOW_DOMAIN="ai-workbench.$DOMAIN"

# --- AI workbench (JupyterHub) ---
# Same hostname Kubeflow used, so existing bookmarks keep working.
WORKBENCH_DOMAIN="ai-workbench.$DOMAIN"
# Set to "false" to skip the workbench in deploy-infra.sh (~2 GB of images).
WORKBENCH_ENABLED="true"
WORKBENCH_SECRET=""              # Keycloak client secret, filled in by deploy-infra.sh
WORKBENCH_IMAGE="quay.io/jupyter/scipy-notebook:latest"
WORKBENCH_STORAGE="10Gi"         # per-user persistent home

# --- Kubeflow / Dex ---
# Fill KUBEFLOW_CLIENT_SECRET after creating the 'kubeflow' client in Keycloak UI.
# (DEX_STATIC_CLIENT_SECRET is no longer needed — Juju manages the dex↔authservice secret.)
KUBEFLOW_CLIENT_SECRET=""

# --- Deployment mode ---
# To deploy only Keycloak on first run (to obtain OAuth secrets), pass as env var:
#   KEYCLOAK_ONLY=true ./deploy-infra.sh

# --- Edge provisioning wizard -------------------------------------------------
# edge/flash-device.sh --ui serves the flashing wizard as a web page and requires
# a Keycloak login. deploy-infra.sh creates the 'edge-wizard' client and fills
# EDGE_WIZARD_SECRET in automatically; the port must match the redirect URIs
# registered for that client.
EDGE_WIZARD_SECRET=""
EDGE_WIZARD_PORT="8088"
# The wizard's address in the browser: the ingress forwards it, over the platform
# TLS certificate, to the daemon on this host (apps/edge-wizard).
ONBOARD_DOMAIN="onboard-device.$DOMAIN"
# Realm role a user must hold to provision hardware. Empty = any realm user.
EDGE_WIZARD_ROLE=""

# --- Config UI authentication -------------------------------------------------
# config.$DOMAIN is served through its own oauth2-proxy so the device inventory,
# recipes and the onboarding entry point require a Keycloak login. Both values
# are filled in by deploy-infra.sh.
CONFIG_OAUTH2_PROXY_SECRET=""
CONFIG_COOKIE_SECRET=""

# --- Access requests and User Manager (apps/access) ---------------------------
# https://access.$DOMAIN/register is the public "Request access" form linked from
# the portal sign-in page; https://access.$DOMAIN/ is the User Manager (realm
# role admin). deploy-infra.sh creates the 'access' Keycloak client and fills
# both secrets in.
ACCESS_DOMAIN="access.$DOMAIN"
ACCESS_CLIENT_SECRET=""
ACCESS_COOKIE_SECRET=""
# E-mail (Gmail account and app password, extra recipients, the four message
# templates) is set in the User Manager → E-mail settings, not here.

# --- Sign-in for the remaining web UIs ----------------------------------------
# Every web UI signs in through Keycloak. deploy-infra.sh creates one client per
# host and fills these in; each app's deploy.sh puts an oauth2-proxy in front.
MONITOR_CLIENT_SECRET=""
MONITOR_COOKIE_SECRET=""
SCHEDULER_CLIENT_SECRET=""
SCHEDULER_COOKIE_SECRET=""
DBMGMT_CLIENT_SECRET=""
DBMGMT_COOKIE_SECRET=""
MQTTX_CLIENT_SECRET=""
MQTTX_COOKIE_SECRET=""
# pgAdmin signs in with Keycloak itself (admins only).
PGADMIN_OAUTH_SECRET=""

# --- MQTT authentication ------------------------------------------------------
# The broker admits nobody anonymously. Boards get one credential each at
# onboarding (edge/flash-device.sh). These are the platform's own service
# accounts — Node-RED (read), scheduler (read sense / write control), MQTT
# Explorer (read/write the topic root) — and the password of mqtt_auth, the
# DB role the broker's auth sidecar reads device credentials with. All
# generated once by deploy-infra.sh and kept.
MQTT_NODE_RED_PASS=""
MQTT_SCHEDULER_PASS=""
MQTT_EXPLORER_PASS=""
MQTT_AUTH_DB_PASS=""
