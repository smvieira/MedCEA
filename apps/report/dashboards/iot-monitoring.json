      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PA68174188487FD5C"
          },
          "rawSql": "SELECT zone_code AS \"Zone\", device_dns AS \"Device\",\n  MAX(CASE WHEN tag='air_temperature' THEN ROUND(value::numeric,1) END) AS \"Temp (\u00b0C)\",\n  MAX(CASE WHEN tag='air_humidity'    THEN ROUND(value::numeric,1) END) AS \"Humidity (%)\",\n  MAX(CASE WHEN tag='co2'             THEN ROUND(value::numeric,0) END) AS \"CO\u2082 (ppm)\",\n  MAX(record_timestamp) AS \"Last Seen\"\nFROM medcea.msg_actual_points\nWHERE unit_code = '$unit' AND $__timeFilter(record_timestamp)\nGROUP BY zone_code, device_dns ORDER BY zone_code",
          "format": "table",
          "refId": "A"
