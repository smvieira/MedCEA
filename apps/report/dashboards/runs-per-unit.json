            "uid": "PA68174188487FD5C"
          },
          "rawSql": "SELECT $__timeGroupAlias(rr.recipe_run_start, '1d'),\n  CASE rr.recipe_run_status::text WHEN 'S' THEN 'Scheduled' WHEN 'R' THEN 'Running' WHEN 'C' THEN 'Completed' WHEN 'F' THEN 'Failed' ELSE rr.recipe_run_status::text END AS metric,\n  count(*) AS value\nFROM medcea.recipe_run rr\nWHERE rr.unit_id IN ($unit) AND $__timeFilter(rr.recipe_run_start)\nGROUP BY 1, 2\nORDER BY 1",
