          "rawSql": "SELECT rr.recipe_run_id AS \"Run\", u.unit_code AS \"Unit\", rr.recipe_id AS \"Recipe\",\n  CASE rr.recipe_run_status::text WHEN 'S' THEN 'Scheduled' WHEN 'R' THEN 'Running' WHEN 'C' THEN 'Completed' WHEN 'F' THEN 'Failed' ELSE rr.recipe_run_status::text END AS \"Status\",\n  rr.recipe_run_start AS \"Start\", rr.recipe_run_end AS \"End\",\n  rr.executed_by_name AS \"Started by\"\nFROM medcea.recipe_run rr\nJOIN medcea.cea_unit u ON u.unit_id = rr.unit_id\nWHERE rr.unit_id IN ($unit) AND $__timeFilter(rr.recipe_run_start)\nORDER BY rr.recipe_run_start DESC\nLIMIT 25",
