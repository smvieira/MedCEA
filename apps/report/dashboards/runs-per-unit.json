        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PA68174188487FD5C"
          },
          "rawSql": "SELECT u.unit_code AS \"Unit\",\n  count(*) FILTER (WHERE rr.recipe_run_status::text = 'S') AS \"Scheduled\",\n  count(*) FILTER (WHERE rr.recipe_run_status::text = 'R') AS \"Running\",\n  count(*) FILTER (WHERE rr.recipe_run_status::text = 'C') AS \"Completed\",\n  count(*) FILTER (WHERE rr.recipe_run_status::text = 'F') AS \"Failed\"\nFROM medcea.recipe_run rr\nJOIN medcea.cea_unit u ON u.unit_id = rr.unit_id\nWHERE rr.unit_id IN ($unit) AND $__timeFilter(rr.recipe_run_start)\nGROUP BY u.unit_code\nORDER BY u.unit_code",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
