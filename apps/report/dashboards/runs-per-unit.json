      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PA68174188487FD5C"
          },
          "rawSql": "SELECT rr.recipe_run_id AS \"Run\", u.unit_code AS \"Unit\", rr.recipe_id AS \"Recipe\",\n  CASE rr.recipe_run_status::text WHEN 'S' THEN 'Scheduled' WHEN 'R' THEN 'Running' WHEN 'C' THEN 'Completed' WHEN 'F' THEN 'Failed' ELSE rr.recipe_run_status::text END AS \"Status\",\n  rr.recipe_run_start AS \"Start\",\n  CASE WHEN rr.recipe_run_status::text = 'R' THEN extract(epoch FROM now() - rr.recipe_run_start) END AS \"Running for\",\n  (SELECT count(*) FROM medcea.recipe_line_cycle_run c WHERE c.recipe_run_id = rr.recipe_run_id\n     AND c.recipe_line_cycle_run_status::text = 'C') AS \"Cycles completed\",\n  rr.executed_by_name AS \"Started by\"\nFROM medcea.recipe_run rr\nJOIN medcea.cea_unit u ON u.unit_id = rr.unit_id\nWHERE rr.unit_id IN ($unit) AND rr.recipe_run_status::text IN ('R', 'S')\nORDER BY rr.recipe_run_start",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
