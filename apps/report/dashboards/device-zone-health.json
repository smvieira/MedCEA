      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PA68174188487FD5C"
          },
          "rawSql": "SELECT count(*) AS \"Zones\"\nFROM medcea.cea_zone z\nLEFT JOIN LATERAL (SELECT m.timestamp FROM medcea.measurement m\n    WHERE m.zone_id = z.zone_id AND m.measure_timestamp >= now() - interval '1 day'\n      AND m.msg_type::text = 'AP'\n    ORDER BY m.measure_timestamp DESC LIMIT 1) ap ON true\nWHERE z.unit_id IN ($unit) AND z.is_active::text = 'Y'\n  AND (ap.timestamp IS NULL OR ap.timestamp < now() - interval '600 seconds')",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ]
    },
