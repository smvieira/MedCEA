        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PA68174188487FD5C"
          },
          "rawSql": "SELECT h.device_dns AS \"Board\", h.msg ->> 'unit_code' AS \"Unit\", z.zone_code AS \"Zone\",\n  h.timestamp AS \"Reported\", extract(epoch FROM now() - h.timestamp) AS \"Report age\",\n  s ->> 'id' AS \"Sensor\",\n  CASE WHEN (s ->> 'ok')::boolean THEN 'OK' ELSE 'Failing' END AS \"State\",\n  s ->> 'err' AS \"Error\", h.msg ->> 'ip' AS \"IP address\"\nFROM medcea.cea_zone z\nJOIN LATERAL (SELECT m.device_dns, m.timestamp, m.msg::jsonb AS msg FROM medcea.measurement m\n    WHERE m.zone_id = z.zone_id AND m.measure_timestamp >= $__timeFrom() AND m.msg_type::text = 'HB'\n    ORDER BY m.measure_timestamp DESC LIMIT 1) h ON true\nCROSS JOIN LATERAL jsonb_array_elements(COALESCE(h.msg -> 'sensors', '[]'::jsonb)) s\nWHERE z.unit_id IN ($unit) AND z.is_active::text = 'Y'\nORDER BY \"State\", h.device_dns, \"Sensor\"",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "id": 7,
      "title": "Boards heard in the time range",
      "description": "Every board that sent anything from a zone of the selected units in the selected time range, with its message counts by type: readings (AP), control reports (SP), health (HB) and test messages (TS). Whether a board is registered as active is not shown: Grafana's database account may not read the device table.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PA68174188487FD5C"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
