              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "OK": {
                        "color": "green",
                        "index": 0
                      },
                      "Failing": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
