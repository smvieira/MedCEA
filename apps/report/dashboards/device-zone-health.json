    {
      "type": "table",
      "id": 6,
      "title": "Board health: sensors in the latest health message",
      "description": "Each SENSE board publishes a health message (HB, topic …/sense/_health) at boot and whenever a sensor's state changes; this shows each sensor of the newest one per active zone within the selected time range. A board with no HB in the time range has no row (widen the range to see an older verdict). Report age is coloured like Reading age; since HB is sent only on a change, an old report is not by itself a fault.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PA68174188487FD5C"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "mappings": []
