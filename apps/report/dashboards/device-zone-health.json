        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PA68174188487FD5C"
          },
          "rawSql": "SELECT count(*) AS \"Sensors\"\nFROM medcea.cea_zone z\nJOIN LATERAL (SELECT m.device_dns, m.timestamp, m.msg::jsonb AS msg FROM medcea.measurement m\n    WHERE m.zone_id = z.zone_id AND m.measure_timestamp >= $__timeFrom() AND m.msg_type::text = 'HB'\n    ORDER BY m.measure_timestamp DESC LIMIT 1) h ON true\nCROSS JOIN LATERAL jsonb_array_elements(COALESCE(h.msg -> 'sensors', '[]'::jsonb)) s\nWHERE z.unit_id IN ($unit) AND z.is_active::text = 'Y'\n  AND NOT (s ->> 'ok')::boolean",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
