      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PA68174188487FD5C"
          },
          "rawSql": "SELECT u.unit_code AS \"Unit\", z.zone_code AS \"Zone\",\n  CASE WHEN z.is_active::text = 'Y' THEN 'Active' ELSE 'Inactive' END AS \"Zone state\",\n  ap.device_dns AS \"Sensor board\", ap.timestamp AS \"Last reading\",\n  extract(epoch FROM now() - ap.timestamp) AS \"Reading age\",\n  sp.device_dns AS \"Control board\", sp.timestamp AS \"Last control report\",\n  hb.timestamp AS \"Last health message\"\nFROM medcea.cea_zone z\nJOIN medcea.cea_unit u ON u.unit_id = z.unit_id\nLEFT JOIN LATERAL (SELECT m.device_dns, m.timestamp FROM medcea.measurement m\n    WHERE m.zone_id = z.zone_id AND m.measure_timestamp >= $__timeFrom() AND m.msg_type::text = 'AP'\n    ORDER BY m.measure_timestamp DESC LIMIT 1) ap ON true\nLEFT JOIN LATERAL (SELECT m.device_dns, m.timestamp FROM medcea.measurement m\n    WHERE m.zone_id = z.zone_id AND m.measure_timestamp >= $__timeFrom() AND m.msg_type::text = 'SP'\n    ORDER BY m.measure_timestamp DESC LIMIT 1) sp ON true\nLEFT JOIN LATERAL (SELECT m.timestamp FROM medcea.measurement m\n    WHERE m.zone_id = z.zone_id AND m.measure_timestamp >= $__timeFrom() AND m.msg_type::text = 'HB'\n    ORDER BY m.measure_timestamp DESC LIMIT 1) hb ON true\nWHERE z.unit_id IN ($unit)\nORDER BY u.unit_code, z.zone_code",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
