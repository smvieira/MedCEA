    {
      "type": "table",
      "id": 4,
      "title": "Completed runs and their release",
      "description": "Completed runs, unreleased first (orange). A run is released in the Configuration UI's Approvals tab by a qp person who did not create, change or execute it; a failed run is never released and is not listed.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "PA68174188487FD5C"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
