      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "PA68174188487FD5C"
          },
          "rawSql": "SELECT rr.recipe_run_id AS \"Run\", u.unit_code AS \"Unit\", rr.recipe_id AS \"Recipe\",\n  rr.recipe_run_end AS \"Completed\",\n  CASE WHEN rel.recipe_run_id IS NULL THEN 'Not released' ELSE 'Released' END AS \"Release\",\n  rel.released_at AS \"Released at\", rel.released_by_name AS \"Released by\",\n  rel.released_by_role AS \"Role\", rel.note AS \"Note\",\n  CASE WHEN rel.recipe_run_id IS NULL THEN extract(epoch FROM now() - rr.recipe_run_end) END AS \"Waiting for\"\nFROM medcea.recipe_run rr\nJOIN medcea.cea_unit u ON u.unit_id = rr.unit_id\nLEFT JOIN medcea.run_release rel ON rel.recipe_run_id = rr.recipe_run_id\nWHERE rr.unit_id IN ($unit) AND rr.recipe_run_status::text = 'C' AND $__timeFilter(rr.recipe_run_end)\nORDER BY (rel.recipe_run_id IS NULL) DESC, rr.recipe_run_end DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ]
    },
