          "rawSql": "SELECT rel.released_at AS \"Released at\", rel.recipe_run_id AS \"Run\", u.unit_code AS \"Unit\",\n  rr.recipe_id AS \"Recipe\", rel.released_by_name AS \"Released by\", rel.released_by_role AS \"Role\",\n  rel.released_by_source AS \"Source\", rel.note AS \"Note\"\nFROM medcea.run_release rel\nJOIN medcea.recipe_run rr ON rr.recipe_run_id = rel.recipe_run_id\nJOIN medcea.cea_unit u ON u.unit_id = rr.unit_id\nWHERE rr.unit_id IN ($unit) AND $__timeFilter(rel.released_at)\nORDER BY rel.released_at DESC",
