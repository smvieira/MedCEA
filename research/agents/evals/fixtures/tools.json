{
 "comment": "The tools the planned mcp-sim/mcp-lake servers declare to a controller-campaign profile (codeplan/rs4-design.md \u00a74.1, \u00a74.5; lake.recipe_line left out to keep the standing prefix under 1,500 tokens), as OpenAI function tools. Function names use _ where the MCP names use . (the gateway maps them: dots are outside the function-name pattern of OpenAI-style tools).",
 "mcp_names": {
  "lake_snapshots": "lake.snapshots",
  "lake_pin": "lake.pin",
  "lake_summary": "lake.summary",
  "sim_validate": "sim.validate",
  "sim_estimate": "sim.estimate",
  "sim_start": "sim.start",
  "sim_status": "sim.status",
  "sim_results": "sim.results",
  "propose": "propose"
