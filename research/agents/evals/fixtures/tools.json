    "parameters": {
     "type": "object",
     "properties": {
      "spec": {
       "type": "object",
       "required": [
        "scenarios",
        "controllers",
        "seeds"
       ],
       "properties": {
        "scenarios": {
         "type": "array",
         "items": {
          "enum": [
           "fungi_pleurotus_fruiting_calibrated",
           "smoke_air_temperature_calibrated"
          ]
         }
        },
        "controllers": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "code"
          ],
          "properties": {
           "code": {
            "enum": [
             "IF_THEN_ELSE",
             "PID",
             "Q_LEARNING",
             "FLC",
             "MPC"
            ]
           },
           "params": {
            "type": "object"
           },
           "params_grid": {
            "type": "object"
           }
          }
         }
        },
        "seeds": {
         "type": "array",
         "items": {
          "type": "integer"
         }
        },
        "clock_offsets_s": {
         "type": "array",
         "items": {
          "type": "number"
         }
        }
       }
      }
     },
     "required": [
      "spec"
     ]
    }
   }
  },
