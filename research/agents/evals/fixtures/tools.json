  {
   "type": "function",
   "function": {
    "name": "lake_snapshots",
    "description": "List snapshots (id, cut, lineage).",
    "parameters": {
     "type": "object",
     "properties": {}
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "lake_pin",
    "description": "Pin a snapshot; its lineage must match.",
    "parameters": {
     "type": "object",
     "properties": {
      "snapshot_id": {
       "type": "integer"
      },
      "expect_lineage": {
       "type": "string"
      }
     },
     "required": [
      "snapshot_id",
      "expect_lineage"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "lake_summary",
    "description": "Hourly n/mean/min/max/sd of a tag in the pinned snapshot.",
    "parameters": {
     "type": "object",
     "properties": {
      "unit": {
       "type": "string"
      },
      "zone": {
       "type": "string"
      },
      "tag": {
       "type": "string"
      }
     },
     "required": [
